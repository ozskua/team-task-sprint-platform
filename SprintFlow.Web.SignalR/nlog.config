<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <targets>
    <!--
      One file per day. ${shortdate} is the whole rotation mechanism: restarting the application on
      the same day appends to the same file, and the next calendar day resolves to a new name.
      No archive settings on purpose — nothing renames, compresses or deletes old files.
      NLog creates the logs directory if it is missing.
    -->
    <target xsi:type="File"
            name="dailyFile"
            fileName="${basedir}/logs/${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}"
            keepFileOpen="true"
            encoding="utf-8" />

    <!-- Development only; wired up in the rules below so production does not duplicate it. -->
    <target xsi:type="ColoredConsole"
            name="console"
            layout="${time}|${level:uppercase=true}|${logger:shortName=true}|${message}${onexception:${newline}${exception:format=message}}" />
  </targets>

  <rules>
    <!-- Framework and EF Core are noisy at Information; only their warnings are worth keeping. -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="Microsoft.EntityFrameworkCore.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <logger name="*" minlevel="Info" writeTo="dailyFile" />

    <!-- Console is a development convenience; production writes to the file only. -->
    <logger name="*" minlevel="Info" writeTo="console">
      <filters defaultAction="Log">
        <when condition="'${environment:ASPNETCORE_ENVIRONMENT}' != 'Development'" action="Ignore" />
      </filters>
    </logger>
  </rules>
</nlog>
