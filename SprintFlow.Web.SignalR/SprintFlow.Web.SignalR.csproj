<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>65bfcd6b-fb9d-4e53-9be8-ba7b8a904979</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Three packages, and deliberately no more. There is no Entity Framework reference: this service
      never touches the database. There is no project reference to any other service either - the
      only thing shared with them is the shape of a JSON message, which each side declares for
      itself.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="6.1.4" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- NLog reads this from the output directory at startup. -->
    <Content Update="nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
