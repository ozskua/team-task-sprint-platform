{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Application": {
    "TimeZone": "Europe/Istanbul"
  },
  "Auth": {
    "AdminUserId": 1
  },
  "Jwt": {
    "Issuer": "SprintFlow.Api",
    "Audience": "SprintFlow.Client",
    "ExpiryMinutes": 480
  },
  "Invitations": {
    "ExpiryHours": 168
  },
  "RabbitMQ": {
    "Port": 5672,
    "VirtualHost": "/"
  }
}
